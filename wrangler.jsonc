{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "octa-mgmt",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [],
  "workers_dev": true
}
